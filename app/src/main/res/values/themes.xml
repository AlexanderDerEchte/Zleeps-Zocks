<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Zocks" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/night_900</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <style name="Theme.Zocks.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/night_900</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.Zocks</item>
  </style>
</resources>
